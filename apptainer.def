Bootstrap: docker
From: rust:1.91.1-slim-bookworm

%files
    Cargo.toml /app/Cargo.toml
    Cargo.lock /app/Cargo.lock
    src /app/src

%post
    apt-get update && \
    apt-get install -y \
      curl gcc g++ libhdf5-dev perl \
      make libsasl2-dev pkg-config \
      libcfitsio-dev && \
    apt-get autoremove && apt-get clean && rm -rf /var/lib/apt/lists/*

    cd /app
    cargo build --release

    cp /app/target/release/add_ascii_catalog /app/add_ascii_catalog
    cp /app/target/release/add_parquet_catalog /app/add_parquet_catalog
    cp /app/target/release/add_csv_catalog /app/add_csv_catalog
    cp /app/target/release/add_fits_catalog /app/add_fits_catalog